# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS settings - comma separated list of allowed origins
# For production, specify exact domains, e.g. BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Use "*" to allow all origins (not recommended for production)
BACKEND_CORS_ORIGINS=*

# Cache settings - TTL in seconds (default: 3600 seconds = 1 hour)
CACHE_DEFAULT_TTL=3600

# Rate limiting - format: number/period (e.g., 100/hour, 10/minute)
RATE_LIMIT=20/minute

# Logging
LOG_LEVEL=INFO
